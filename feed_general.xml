<guid isPermaLink="true">https://www.banglatribune.com/press-release/974648/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%A8-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8</guid>
<description>আন্তর্জাতিক পর্যটন চলচ্চিত্র উৎসব কমিটির (সিআইএফএফটি) এশিয়া অঞ্চলের দূত হিসেবে নিয়োগ পেয়েছেন বাংলাদেশের পর্যটন ব্যক্তিত্ব মোহাম্মদ জহিরুল ইসলাম, যিনি ডাল্টন জহির নামে পরিচিত। গত ৬ অক্টোবর অস্ট্রিয়ার রাজধানী ভিয়েনা থেকে এ নিয়োগের ঘোষণা দেয় সংস্থাটি। জাতিসংঘের বিশ্ব পর্যটন সংস্থার সহযোগী সদস্য </description>
<source url="https://www.banglatribune.com/press-release/974648/%E0%A6%86%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A7%8D%E0%A6%9C%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%95-%E0%A6%AA%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%9F%E0%A6%A8-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A7%8D%E0%A6%A5%E0%A6%BE%E0%A6%B0-%E0%A6%8F%E0%A6%B6%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE-%E0%A6%85%E0%A6%9E%E0%A7%8D%E0%A6%9A%E0%A6%B2%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A7%82%E0%A6%A4-%E0%A6%B9%E0%A6%B2%E0%A7%87%E0%A6%A8">বাংলা ট্রিবিউন</source>
<pubDate>Thu, 15 Oct 2026 09:50:34 -0000</pubDate>
