<link>https://www.banglatribune.com/foreign/982054/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8</link>
<guid isPermaLink="true">https://www.banglatribune.com/foreign/982054/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8</guid>
<description>যুক্তরাজ্যের ব্র্যাডফোর্ডে পারিবারিক সহিংসতার জেরে পাকিস্তানি বংশোদ্ভূত ৪৬ বছর বয়সী তাহিরা হুসেনকে হত্যা এবং ২০ বছর বয়সী এক তরুণীকে হত্যাচেষ্টার অভিযোগে বিলাল আজমল (২৬) নামে এক ব্রিটিশ-পাকিস্তানি যুবককে আদালতে হাজির করা হয়েছে। বৃহস্পতিবার (১৯ নভেম্বর) ব্র্যাডফোর্ড ম্যাজিস্ট্রেট আদালত তাকে কারাগার</description>
<source url="https://www.banglatribune.com/foreign/982054/%E0%A6%AD%E0%A6%BF%E0%A6%B8%E0%A6%BE-%E0%A6%86%E0%A6%AC%E0%A7%87%E0%A6%A6%E0%A6%A8%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0%E0%A6%A6%E0%A6%BF%E0%A6%A8-%E0%A6%AF%E0%A7%81%E0%A6%95%E0%A7%8D%E0%A6%A4%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A7%8D%E0%A6%AF%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A7%8D%E0%A6%B0%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%A1%E0%A6%AB%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%A1%E0%A7%87-%E0%A6%96%E0%A7%81%E0%A6%A8">বাংলা ট্রিবিউন</source>
