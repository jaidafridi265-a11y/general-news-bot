</item>
<item>
<title>হাত ধোয়ার চর্চায় পিছিয়ে বাংলাদেশ</title>
<link>https://www.banglatribune.com/health/974646/%E0%A6%B9%E0%A6%BE%E0%A6%A4-%E0%A6%A7%E0%A7%8B%E0%A7%9F%E0%A6%BE%E0%A6%B0-%E0%A6%9A%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A6%BE%E0%A7%9F-%E0%A6%AA%E0%A6%BF%E0%A6%9B%E0%A6%BF%E0%A7%9F%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%82%E0%A6%B2%E0%A6%BE%E0%A6%A6%E0%A7%87%E0%A6%B6</link>
