<guid isPermaLink="true">https://www.banglatribune.com/foreign/usa/976179/%E0%A6%B6%E0%A6%BE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A6%AB%E0%A7%81%E0%A6%9F%E0%A6%AC%E0%A6%B2-%E0%A6%AE%E0%A7%8D%E0%A6%AF%E0%A6%BE%E0%A6%9A-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87-%E0%A6%B8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%9A%E0%A7%87%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%AC%E0%A7%87%E0%A6%81%E0%A6%A7%E0%A7%87</guid>
<description>যুক্তরাষ্ট্রের ভার্জিনিয়া রাজ্যে ফুটবল ম্যাচ নির্বিঘ্নে বা শান্তিতে দেখার জন্য স্ত্রীকে বাড়ির বেসমেন্টে একটি চেয়ারের সঙ্গে টেপ দিয়ে বেঁধে রাখার অভিযোগে এক ব্যক্তিকে গ্রেফতার করা হয়েছে। তার বিরুদ্ধে অপহরণ, পারিবারিক সদস্যকে মারধরসহ একাধিক অভিযোগ আনা হয়েছে। অভিযুক্ত ব্যক্তির নাম টেরি ওয়ার্ড। ৬৪ বছর </description>
