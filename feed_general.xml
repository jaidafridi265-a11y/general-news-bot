<link>https://www.banglatribune.com/law-and-crime/975939/%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87%E2%80%99-%E0%A6%B9%E0%A7%9F</link>
<guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/975939/%E0%A6%B8%E0%A7%9C%E0%A6%95-%E0%A6%A6%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%98%E0%A6%9F%E0%A6%A8%E0%A6%BE%E0%A6%B0-%E0%A6%95%E0%A7%8D%E0%A6%B7%E0%A6%A4%E0%A6%BF%E0%A6%AA%E0%A7%82%E0%A6%B0%E0%A6%A3-%E0%A6%AA%E0%A7%87%E0%A6%A4%E0%A7%87-%E2%80%98%E0%A6%B9%E0%A6%BE%E0%A6%87%E0%A6%95%E0%A7%8B%E0%A6%B0%E0%A7%8D%E0%A6%9F-%E0%A6%A6%E0%A7%87%E0%A6%96%E0%A6%A4%E0%A7%87%E2%80%99-%E0%A6%B9%E0%A7%9F</guid>
<description>সড়ক দুর্ঘটনায় স্বজন হারিয়ে নিঃস্ব পরিবার কিংবা স্থায়ীভাবে পঙ্গুত্ববরণ করা মানুষের জন্য ক্ষতিপূরণ পাওয়া এখনো বড় চ্যালেঞ্জ। আইনে আর্থিক সহায়তার বিধান থাকলেও ক্ষতিপূরণের পরিমাণ, আবেদন প্রক্রিয়ার জটিলতা ও দীর্ঘসূত্রতা নিয়ে প্রশ্ন রয়েছে। ন্যায্য ক্ষতিপূরণ পেতে তাই অনেক ভুক্তভোগীকে দ্বারস্থ হতে হচ্ছে উচ্চ</description>
