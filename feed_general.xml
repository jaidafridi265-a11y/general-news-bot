<guid isPermaLink="true">https://www.banglatribune.com/national/974437/%E0%A7%AF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8</guid>
<description>আগামী ৯ নভেম্বর বসছে ত্রয়োদশ জাতীয় সংসদের চতুর্থ অধিবেশন। ওই দিন বিকাল সাড়ে ৩টায় জাতীয় সংসদ ভবনের সংসদ কক্ষে অধিবেশন শুরু হবে। বুধবার (১৪ অক্টোবর) রাষ্ট্রপতি মির্জা ফখরুল ইসলাম আলমগীর সংবিধানের ৭২ অনুচ্ছেদের (১) দফায় প্রদত্ত ক্ষমতাবলে এ অধিবেশন আহ্বান করেন। জাতীয় সংসদ সচিবালয়ের আইন প্রণয়ন শাখা-১ থেক</description>
<source url="https://www.banglatribune.com/national/974437/%E0%A7%AF-%E0%A6%A8%E0%A6%AD%E0%A7%87%E0%A6%AE%E0%A7%8D%E0%A6%AC%E0%A6%B0-%E0%A6%AC%E0%A6%B8%E0%A6%9B%E0%A7%87-%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%9F%E0%A7%8B%E0%A6%A6%E0%A6%B6-%E0%A6%B8%E0%A6%82%E0%A6%B8%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%9A%E0%A6%A4%E0%A7%81%E0%A6%B0%E0%A7%8D%E0%A6%A5-%E0%A6%85%E0%A6%A7%E0%A6%BF%E0%A6%AC%E0%A7%87%E0%A6%B6%E0%A6%A8">বাংলা ট্রিবিউন</source>
<pubDate>Wed, 14 Oct 2026 10:00:12 -0000</pubDate>
