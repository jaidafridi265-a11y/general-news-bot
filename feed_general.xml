<guid isPermaLink="true">https://www.banglatribune.com/entertainment/bollywood/974849/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A7%9F%E0%A6%95</guid>
<description>ভারত ছাড়ার নির্দেশের বিরুদ্ধে বোম্বে হাইকোর্টে যাওয়ার সিদ্ধান্ত নিয়েছেন অভিনেতা ইমরান খান। যুক্তরাষ্ট্রের নাগরিক ও ভারতের ওভারসিজ সিটিজেন অব ইন্ডিয়া (ওসিআই) কার্ডধারী এই অভিনেতাকে আগামী ২৮ অক্টোবরের মধ্যে ভারত ছাড়ার নির্দেশ দিয়েছে দেশটির ফরেনার্স রিজিওনাল রেজিস্ট্রেশন অফিস (এফআরআরও)। এ নির্দেশকে চ্য</description>
<source url="https://www.banglatribune.com/entertainment/bollywood/974849/%E0%A6%AD%E0%A6%BE%E0%A6%B0%E0%A6%A4-%E0%A6%9B%E0%A6%BE%E0%A7%9C%E0%A6%BE%E0%A6%B0-%E0%A6%A8%E0%A6%BF%E0%A6%B0%E0%A7%8D%E0%A6%A6%E0%A7%87%E0%A6%B6%E0%A7%87%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B0%E0%A7%81%E0%A6%A6%E0%A7%8D%E0%A6%A7%E0%A7%87-%E0%A6%86%E0%A6%A6%E0%A6%BE%E0%A6%B2%E0%A6%A4%E0%A7%87-%E0%A6%AF%E0%A6%BE%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8-%E0%A6%A8%E0%A6%BE%E0%A7%9F%E0%A6%95">বাংলা ট্রিবিউন</source>
