<guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/978944/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4</guid>
<description>সাংবাদিক দম্পতি সাগর সরওয়ার ও মেহেরুন রুনি হত্যা মামলার তদন্ত প্রতিবেদন দাখিলের তারিখ পিছিয়েছে। আগামী ৯ ডিসেম্বর তদন্ত প্রতিবেদন দাখিলের তারিখ নির্ধারণ করেছেন আদালত। এ নিয়ে এই দম্পতির হত্যা মামলার প্রতিবেদন দাখিলের তারিখ ১৩১ বার পেছালো। বৃহস্পতিবার (৫ নভেম্বর) শুনানি শেষে ঢাকা মেট্রোপলিটন ম্যাজিস</description>
<source url="https://www.banglatribune.com/law-and-crime/978944/%E0%A6%B8%E0%A6%BE%E0%A6%97%E0%A6%B0-%E0%A6%B0%E0%A7%81%E0%A6%A8%E0%A6%BF-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%AE%E0%A6%BE%E0%A6%AE%E0%A6%B2%E0%A6%BE-%E0%A7%A7%E0%A7%A9%E0%A7%A7-%E0%A6%AC%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AE%E0%A6%A4%E0%A7%8B-%E0%A6%AA%E0%A7%87%E0%A6%9B%E0%A6%BE%E0%A6%B2%E0%A7%8B-%E0%A6%A4%E0%A6%A6%E0%A6%A8%E0%A7%8D%E0%A6%A4">বাংলা ট্রিবিউন</source>
