<item>
<title>স্নিগ্ধ ও পরিমিত লুকে জয়া আহসান</title>
<link>https://www.banglatribune.com/lifestyle/974680/%E0%A6%B8%E0%A7%8D%E0%A6%A8%E0%A6%BF%E0%A6%97%E0%A7%8D%E0%A6%A7-%E0%A6%93-%E0%A6%AA%E0%A6%B0%E0%A6%BF%E0%A6%AE%E0%A6%BF%E0%A6%A4-%E0%A6%B2%E0%A7%81%E0%A6%95%E0%A7%87-%E0%A6%9C%E0%A7%9F%E0%A6%BE-%E0%A6%86%E0%A6%B9%E0%A6%B8%E0%A6%BE%E0%A6%A8</link>
