<item>
<title>পেঁয়াজের দাম কমেছে কেজিতে ১৫ টাকা</title>
<link>https://www.banglatribune.com/country/rangpur/979403/%E0%A6%AA%E0%A7%87%E0%A6%81%E0%A7%9F%E0%A6%BE%E0%A6%9C%E0%A7%87%E0%A6%B0-%E0%A6%A6%E0%A6%BE%E0%A6%AE-%E0%A6%95%E0%A6%AE%E0%A7%87%E0%A6%9B%E0%A7%87-%E0%A6%95%E0%A7%87%E0%A6%9C%E0%A6%BF%E0%A6%A4%E0%A7%87-%E0%A7%A7%E0%A7%AB-%E0%A6%9F%E0%A6%BE%E0%A6%95%E0%A6%BE</link>
