<guid isPermaLink="true">https://www.banglatribune.com/country/chitagong/975011/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%9C%E0%A6%A8</guid>
<description>চট্টগ্রামের সীতাকুণ্ডে দুর্বৃত্তদের গুলিতে তারেক হোসেন বাপ্পি (২৬) নামে এক যুবদল কর্মী নিহত হয়েছেন। এ ঘটনায় গুলিবিদ্ধ হয়ে গুরুতর আহত হয়েছেন তাফসির আলম শাওন (২২) নামে আরেক যুবদল কর্মী। তিনি চট্টগ্রাম মেডিক্যাল কলেজ হাসপাতালের নিবিড় পরিচর্যা কেন্দ্রে (আইসিইউ) চিকিৎসাধীন। তার অবস্থাও সংকটাপন্ন। শুক্রবা</description>
<source url="https://www.banglatribune.com/country/chitagong/975011/%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A6%A7%E0%A6%B0%E0%A7%87%E0%A6%B0-%E0%A6%AA%E0%A6%B0-%E0%A6%97%E0%A7%81%E0%A6%B2%E0%A6%BF-%E0%A6%95%E0%A6%B0%E0%A7%87-%E0%A6%AF%E0%A7%81%E0%A6%AC%E0%A6%A6%E0%A6%B2-%E0%A6%95%E0%A6%B0%E0%A7%8D%E0%A6%AE%E0%A7%80%E0%A6%95%E0%A7%87-%E0%A6%B9%E0%A6%A4%E0%A7%8D%E0%A6%AF%E0%A6%BE-%E0%A6%86%E0%A6%B0%E0%A7%87%E0%A6%95%E0%A6%9C%E0%A6%A8">বাংলা ট্রিবিউন</source>
