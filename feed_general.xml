<link>https://www.banglatribune.com/law-and-crime/977877/%E0%A6%95%E0%A7%87%E0%A6%A8%E0%A7%8D%E0%A6%A6%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%AF%E0%A6%BC-%E0%A6%95%E0%A6%BE%E0%A6%B0%E0%A6%BE%E0%A6%97%E0%A6%BE%E0%A6%B0%E0%A7%87-%E0%A6%B9%E0%A6%A0%E0%A6%BE%E0%A7%8E-%E0%A6%85%E0%A6%B8%E0%A7%81%E0%A6%B8%E0%A7%8D%E0%A6%A5-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%A4%E0%A6%BF-%E0%A6%A2%E0%A6%BE%E2%80%8C%E0%A6%AE%E0%A7%87%E2%80%8C%E0%A6%95%E0%A7%87</link>
