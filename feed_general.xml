</item>
<item>
<title>প্রধানমন্ত্রীর আগমন ঘিরে সাজছে রাজশাহী, চলছে শেষ মুহূর্তের প্রস্তুতি</title>
<link>https://www.banglatribune.com/country/rajshahi/975443/%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8%E0%A6%AE%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A7%8D%E0%A6%B0%E0%A7%80%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A6%AE%E0%A6%A8-%E0%A6%98%E0%A6%BF%E0%A6%B0%E0%A7%87-%E0%A6%B8%E0%A6%BE%E0%A6%9C%E0%A6%9B%E0%A7%87-%E0%A6%B0%E0%A6%BE%E0%A6%9C%E0%A6%B6%E0%A6%BE%E0%A6%B9%E0%A7%80-%E0%A6%9A%E0%A6%B2%E0%A6%9B%E0%A7%87-%E0%A6%B6%E0%A7%87%E0%A6%B7</link>
