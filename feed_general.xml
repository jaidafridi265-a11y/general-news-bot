<guid isPermaLink="true">https://www.banglatribune.com/national/974550/%E0%A6%B2%E0%A6%82%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87</guid>
<description>লংমার্চের মাধ্যমে বিদ্যুৎ উৎপাদন বাড়ানো সম্ভব নয় বলে উল্লেখ করেছেন জাতীয় সংসদের চিফ হুইপ ও বরগুনা-২ আসনের সংসদ সদস্য নূরুল ইসলাম মনি। তিনি বলেন, ‘‘লংমার্চে বিদ্যুৎ উৎপাদন সম্ভব হলে বিএনপি সবার আগে সেই কর্মসূচি পালন করতো। বিগত আওয়ামী লীগ সরকারের আমলে বিদ্যুৎ খাতে সৃষ্ট সমস্যাগুলোর প্রভাব মোকাবিলা করা</description>
<source url="https://www.banglatribune.com/national/974550/%E0%A6%B2%E0%A6%82%E0%A6%AE%E0%A6%BE%E0%A6%B0%E0%A7%8D%E0%A6%9A%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%A6%E0%A7%8D%E0%A6%AF%E0%A7%81%E0%A7%8E-%E0%A6%89%E0%A7%8E%E0%A6%AA%E0%A6%BE%E0%A6%A6%E0%A6%A8-%E0%A6%B8%E0%A6%AE%E0%A7%8D%E0%A6%AD%E0%A6%AC-%E0%A6%B9%E0%A6%B2%E0%A7%87-%E0%A6%AC%E0%A6%BF%E0%A6%8F%E0%A6%A8%E0%A6%AA%E0%A6%BF-%E0%A6%B8%E0%A6%AC%E0%A6%BE%E0%A6%B0-%E0%A6%86%E0%A6%97%E0%A7%87">বাংলা ট্রিবিউন</source>
