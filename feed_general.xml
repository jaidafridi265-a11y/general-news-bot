<guid isPermaLink="true">https://www.banglatribune.com/foreign/asia/978411/%E0%A6%B8%E0%A6%BF%E0%A6%A8%E0%A6%9A%E0%A6%BF%E0%A6%AF%E0%A6%BC%E0%A6%BE%E0%A6%82%E0%A6%AF%E0%A6%BC%E0%A7%87-%E0%A6%9C%E0%A6%BF%E0%A6%B0%E0%A6%95%E0%A6%A8-%E0%A6%AC%E0%A6%BE%E0%A6%B2%E0%A7%81%E0%A6%B0-%E0%A6%AC%E0%A6%BF%E0%A6%B6%E0%A6%BE%E0%A6%B2-%E0%A6%AE%E0%A6%9C%E0%A7%81%E0%A6%A6%E0%A7%87%E0%A6%B0-%E0%A6%B8%E0%A6%A8%E0%A7%8D%E0%A6%A7%E0%A6%BE%E0%A6%A8-%E0%A6%AA%E0%A7%87%E0%A6%B2%E0%A7%8B</guid>
<description>চীনের সিনচিয়াং উইগুর স্বায়ত্তশাসিত অঞ্চলের আকসু প্রিফেকচারের বাইছেন কাউন্টিতে জিরকন বালুর একটি বিশাল মজুদ আবিষ্কৃত হয়েছে। বেইজিংয়ে আয়োজিত এক সংবাদ সম্মেলনে সম্প্রতি দেশটির প্রাকৃতিক সম্পদ মন্ত্রণালয় এই ঐতিহাসিক আবিষ্কারের ঘোষণা দেয়। দেশীয় ইঞ্জিন ও এআই সমন্বয়ে আরও শক্তিশালী চীনের জে-২০ যুদ্ধবি</description>
