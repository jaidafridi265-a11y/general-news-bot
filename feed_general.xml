<guid isPermaLink="true">https://www.banglatribune.com/law-and-crime/974899/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A7%A7%E0%A7%A6%E0%A7%AD-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%A7%E0%A7%AC-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0</guid>
<description>সৌদি আরবের রিয়াদ ও দাম্মাম বিমানবন্দর বন্ধ থাকায় গত ১০ অক্টোবর থেকে শুক্রবার (১৬ অক্টোবর) পর্যন্ত ঢাকা থেকে এসব বিমানবন্দরগামী ১০৭টি ফ্লাইট বাতিল হয়েছে। এতে আটকা পড়েছেন ১৬ হাজার ৬২০ জন যাত্রী। শুক্রবার (১৬ অক্টোবর) বিকালে বেসামরিক বিমান চলাচল কর্তৃপক্ষের (বেবিচক) জনসংযোগ বিভাগের সহকারী পরিচালক কাওছা</description>
<source url="https://www.banglatribune.com/law-and-crime/974899/%E0%A6%A2%E0%A6%BE%E0%A6%95%E0%A6%BE-%E0%A6%A5%E0%A7%87%E0%A6%95%E0%A7%87-%E0%A6%AC%E0%A6%BE%E0%A6%A4%E0%A6%BF%E0%A6%B2-%E0%A7%A7%E0%A7%A6%E0%A7%AD-%E0%A6%AB%E0%A7%8D%E0%A6%B2%E0%A6%BE%E0%A6%87%E0%A6%9F-%E0%A6%86%E0%A6%9F%E0%A6%95%E0%A6%BE-%E0%A6%B8%E0%A6%BE%E0%A7%9C%E0%A7%87-%E0%A7%A7%E0%A7%AC-%E0%A6%B9%E0%A6%BE%E0%A6%9C%E0%A6%BE%E0%A6%B0%E0%A7%87%E0%A6%B0">বাংলা ট্রিবিউন</source>
